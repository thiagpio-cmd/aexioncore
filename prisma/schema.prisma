// ============================================================================
// Phase-2 Engine Models — Debrief / Behavioral / Money / Action Proposal
// ============================================================================

// 11. Debrief — Debrief de negociação submetido pelo corretor (texto, arquivo ou áudio)
//     Substitui/complementa DealDebrief/DebriefSession com ciclo de vida mais rico
model Debrief {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  inputType      String   // 'text' | 'file' | 'audio'
  rawInput       String   @db.Text  // conteúdo bruto submetido pelo usuário
  fileUrl        String?            // URL do arquivo/áudio (se aplicável)

  // Saída estruturada do AI
  interpretation  Json?  // o que o AI entendeu da situação
  proposedActions Json?  // array de ações sugeridas pelo AI
  approvedActions Json?  // subconjunto aprovado pelo usuário

  status     String   @default("pending") // 'pending' | 'reviewed' | 'applied'
  confidence Float?   // confiança geral da interpretação (0-1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Phase-2 — ações geradas a partir deste debrief
  actionProposals ActionProposal[]

  @@index([opportunityId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("debriefs")
}

// 12. BehavioralSnapshot — Snapshot periódico do comportamento de execução do corretor
model BehavioralSnapshot {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  executionScore  Int     // 0-100 — score de execução no período
  intentAvg       Float   // média de intentScore das oportunidades ativas
  momentumAvg     Float   // média de momentumScore das oportunidades ativas
  responseGapAvg  Float   // média de gap de resposta (horas)
  flags           Json    // string[] — flags comportamentais detectadas

  period       String   // 'daily' | 'weekly'
  snapshotDate DateTime // data de referência do snapshot

  createdAt DateTime @default(now())

  @@index([userId, snapshotDate])
  @@index([organizationId, period])
  @@map("behavioral_snapshots")
}

// 13. MoneySnapshot — Snapshot do dinheiro em risco por oportunidade (histórico)
model MoneySnapshot {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  moneyAtRisk      Float  // R$ total em risco
  commissionAtRisk Float  // R$ comissão em risco
  delayCost        Float  // R$ custo estimado de atraso
  riskFactor       Float  // 0-1 — fator de risco composto
  riskReasons      Json   // string[] — razões do risco neste momento

  calculatedAt DateTime @default(now())

  @@index([opportunityId, calculatedAt])
  @@index([organizationId, calculatedAt])
  @@map("money_snapshots")
}

// 14. ActionProposal — Ação proposta pelo AI (de debrief, recommendation ou alert)
//     Ciclo de vida: proposed → approved/rejected → executed
model ActionProposal {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  opportunityId  String
  opportunity    Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  // Origem da proposta
  debriefId String?
  debrief   Debrief? @relation(fields: [debriefId], references: [id], onDelete: SetNull)
  source    String   // 'debrief' | 'recommendation' | 'alert'

  // Conteúdo da ação
  actionType   String  // 'create_task' | 'move_stage' | 'update_probability' | 'mark_risk' | 'schedule_follow_up' | 'create_reminder'
  description  String  // descrição legível em português
  urgency      String  // 'immediate' | 'today' | 'this_week'
  params       Json    // parâmetros específicos da ação (taskTitle, targetStage, newProbability, etc.)

  financialImpact String?  // descrição do impacto financeiro em R$ (ex.: "R$ 45.000 em risco")

  // Ciclo de vida
  status     String    @default("proposed") // 'proposed' | 'approved' | 'rejected' | 'executed'
  executedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([opportunityId, status])
  @@index([userId, status])
  @@index([organizationId, status])
  @@map("action_proposals")
}

// ============================================================================
// Customer Psychographic Profiling
// ============================================================================

model CustomerProfile {
  id             String   @id @default(cuid())
  contactId      String
  contact        Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Big Five Personality Traits (each 0-100)
  bigFive        Json?    // {openness, conscientiousness, extraversion, agreeableness, neuroticism}

  // Jungian Archetype
  jungArchetype  String?  // hero|explorer|sage|rebel|magician|lover|caregiver|ruler

  // Lifestyle dimensions
  lifestyle      Json?    // {interests: string[], values: string[], priorities: string[]}

  // Perceived Value Sensitivity per Zeithaml & Bitner (each 0-100)
  valueSensitivity Json?  // {functional, emotional, social, epistemic, conditional}

  // Self-Determination Theory — Deci & Ryan (each 0-100)
  motivationProfile Json? // {autonomy, competence, relatedness}

  // Conditioning Profile (each 0-100)
  conditioningProfile Json? // {rewardSensitivity, lossAversion, habituationRate}

  // BJ Fogg BMAP-inspired composite (0-100)
  fomapScore     Int?

  // Profile reliability (0-1)
  confidence     Float?   @default(0)

  lastUpdatedAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([contactId])
  @@index([organizationId])
  @@unique([contactId, organizationId])
  @@map("customer_profiles")
}

// ============================================================================
// CRE Models
// ============================================================================

model Commission {
  id              String   @id @default(cuid())
  organizationId  String
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  agentId         String
  role            String    // LISTING_AGENT, BUYERS_AGENT, REFERRAL, COOP_BROKER
  splitPercent    Float
  grossAmount     Float     @default(0)
  netAmount       Float     @default(0)
  status          String    @default("PENDING") // PENDING, EARNED, PAID
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([opportunityId])
  @@index([agentId])
  @@index([organizationId])
  @@map("commissions")
}

model PropertyComp {
  id              String    @id @default(cuid())
  organizationId  String
  address         String
  city            String?
  state           String?
  propertyType    String    // OFFICE, RETAIL, INDUSTRIAL, MULTIFAMILY, etc.
  sqft            Float?
  salePrice       Float?
  pricePerSqft    Float?
  capRate         Float?
  noi             Float?
  occupancyRate   Float?
  closedDate      DateTime?
  source          String?   @default("MANUAL") // MANUAL, COSTAR, LOOPNET, CREXI
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId])
  @@index([propertyType])
  @@map("property_comps")
}

model DealDocument {
  id              String    @id @default(cuid())
  organizationId  String
  opportunityId   String
  opportunity     Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type            String    // LOI, PSA, NDA, LEASE, AMENDMENT, CA, ESTOPPEL, SURVEY, ENVIRONMENTAL, TITLE, FINANCIAL
  name            String
  fileUrl         String?
  version         Int       @default(1)
  status          String    @default("DRAFT") // DRAFT, SENT, UNDER_REVIEW, SIGNED, EXPIRED, REJECTED
  sentAt          DateTime?
  signedAt        DateTime?
  expiresAt       DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([opportunityId])
  @@index([organizationId])
  @@map("deal_documents")
}
